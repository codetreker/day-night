{
  "name": "daynight",
  "version": "0.1.0",
  "description": "A foreground CLI for GitHub pull request reviews",
  "type": "module",
  "bin": {
    "daynight": "dist/main.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
