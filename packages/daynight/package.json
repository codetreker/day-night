{
  "name": "@codetreker/daynight",
  "version": "0.1.1",
  "description": "A foreground CLI for GitHub pull request reviews",
  "type": "module",
  "bin": {
    "daynight": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "acceptance": "pnpm run build && vitest run --config vitest.acceptance.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cross-spawn": "7.0.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
